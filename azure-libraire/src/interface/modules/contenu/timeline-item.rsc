.az-timeline-item { display: flex; flex-direction: row; gap: 12px; }
.az-timeline-dot { width: 10px; height: 10px; margin-top: 5px; border-radius: $rayon-rond; background-color: $accent; flex-shrink: 0; }
.az-timeline-body { display: flex; flex-direction: column; gap: 3px; flex-grow: 1; }
.az-timeline-head { display: flex; flex-direction: row; gap: 10px; align-items: center; }
.az-timeline-title { color: $texte-fort; font-size: 14px; font-weight: 600; }
.az-timeline-date { color: $texte-faible; font-size: 12px; }
