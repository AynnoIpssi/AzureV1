.az-price { display: flex; flex-direction: column; gap: 8px; padding: 20px; background-color: $surface; border: 1px solid $accent/25; border-radius: $rayon-grand; }
.az-price-name { color: $accent-texte; font-size: 13px; font-weight: 700; }
.az-price-row { display: flex; flex-direction: row; align-items: flex-end; gap: 6px; }
.az-price-amount { color: $texte-fort; font-size: 30px; font-weight: 700; }
.az-price-period { color: $texte-discret; font-size: 13px; margin-bottom: 6px; }
.az-price-item { color: $texte-doux; font-size: 13px; }
