.az-list-item { display: flex; flex-direction: row; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid $trait/5; }
.az-list-main { display: flex; flex-direction: column; gap: 2px; flex-grow: 1; }
.az-list-title { color: $texte-fort; font-size: 14px; font-weight: 500; }
.az-list-desc { color: $texte-discret; font-size: 12px; }
