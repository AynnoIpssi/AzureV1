.az-accordion { display: flex; flex-direction: column; border: 1px solid $trait/6; border-radius: $rayon-moyen; background-color: $surface; }
.az-accordion-head { padding: 12px 16px; background-color: transparent; color: $texte-fort; font-size: 14px; font-weight: 500; text-align: left; }
.az-accordion-head.on { color: $accent-texte; }
.az-accordion-body { display: flex; flex-direction: column; gap: 6px; padding: 0 16px 14px 16px; color: $texte-attenue; font-size: 13px; }
