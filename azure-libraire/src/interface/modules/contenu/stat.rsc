.az-stat { display: flex; flex-direction: column; gap: 4px; padding: 16px 18px; background-color: $surface; border: 1px solid $trait/6; border-radius: $rayon-grand; }
.az-stat-label { color: $texte-discret; font-size: 12px; font-weight: 600; }
.az-stat-value { color: $texte-fort; font-size: 26px; font-weight: 700; }
.az-stat-detail { color: $texte-discret; font-size: 12px; }
.az-stat-detail.hausse { color: $succes-texte; }
.az-stat-detail.baisse { color: $danger-texte; }
