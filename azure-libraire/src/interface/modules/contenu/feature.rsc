.az-feature { display: flex; flex-direction: column; gap: 8px; padding: 18px; background-color: $surface; border-radius: $rayon-grand; }
.az-feature-icon { width: 36px; height: 36px; border-radius: $rayon-moyen; background: linear-gradient(135deg, $accent 0%, $accent-sombre 100%); }
.az-feature-title { color: $texte-fort; font-size: 15px; font-weight: 600; }
.az-feature-desc { color: $texte-discret; font-size: 13px; }
