.az-avatar { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: $rayon-rond; background: linear-gradient(135deg, $accent 0%, $accent-sombre 100%); flex-shrink: 0; }
.az-avatar-text { color: $sur-couleur; font-size: 15px; font-weight: 700; }
