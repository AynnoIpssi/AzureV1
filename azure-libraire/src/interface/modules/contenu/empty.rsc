.az-empty { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 32px; border: 1px dashed $trait/12; border-radius: $rayon-grand; }
.az-empty-icon { width: 44px; height: 44px; border-radius: $rayon-rond; background-color: $surface-4; }
.az-empty-title { color: $texte-fort; font-size: 15px; font-weight: 600; }
.az-empty-text { color: $texte-discret; font-size: 13px; text-align: center; }
