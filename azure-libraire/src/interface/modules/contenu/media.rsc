.az-media { display: flex; flex-direction: row; align-items: center; gap: 12px; }
.az-media-main { display: flex; flex-direction: column; gap: 2px; flex-grow: 1; min-width: 0; }
.az-media-title { color: $texte-fort; font-size: 14px; font-weight: 600; }
.az-media-desc { color: $texte-discret; font-size: 12px; }
