.az-card { display: flex; flex-direction: column; gap: 8px; padding: 16px 18px; background-color: $surface; border: 1px solid $trait/6; border-radius: $rayon-grand; }
.az-card-title { color: $texte-fort; font-size: 16px; font-weight: 600; }
.az-card-desc { color: $texte-discret; font-size: 13px; }
.az-card-body { display: flex; flex-direction: column; gap: 8px; }
.az-card-foot { color: $texte-faible; font-size: 12px; margin-top: 4px; }
