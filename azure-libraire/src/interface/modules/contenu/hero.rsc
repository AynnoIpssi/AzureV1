.az-hero { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 40px 24px; background: linear-gradient(135deg, $accent/16 0%, $accent/10 100%); border-radius: $rayon-large; }
.az-hero-title { color: $texte-fort; font-size: 32px; font-weight: 700; text-align: center; }
.az-hero-desc { color: $texte-attenue; font-size: 15px; text-align: center; }
.az-hero-actions { display: flex; flex-direction: row; gap: 10px; margin-top: 6px; }
