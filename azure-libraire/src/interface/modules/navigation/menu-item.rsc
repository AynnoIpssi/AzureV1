.az-menu-item { padding: 8px 12px; border-radius: $rayon; background-color: transparent; color: $texte-discret; font-size: 14px; text-align: left; }
.az-menu-item:hover { background-color: $trait/5; color: $texte-fort; }
.az-menu-item.on { background-color: $accent/12; color: $accent-texte; font-weight: 600; }
