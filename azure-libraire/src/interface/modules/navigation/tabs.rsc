.az-tabs { display: flex; flex-direction: row; gap: 4px; padding: 4px; border-radius: $rayon-moyen; background-color: $surface; }
.az-tab { padding: 7px 14px; border-radius: $rayon-petit; background-color: transparent; color: $texte-discret; font-size: 13px; font-weight: 500; }
.az-tab:hover { color: $texte-fort; }
.az-tab.on { background-color: $surface-5; color: $texte-fort; font-weight: 600; }
