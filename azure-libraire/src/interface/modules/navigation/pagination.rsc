.az-pagination { display: flex; flex-direction: row; gap: 4px; }
.az-pagelink { width: 34px; height: 34px; padding: 0; border-radius: $rayon; background-color: $surface-2; color: $texte-attenue; font-size: 13px; }
.az-pagelink:hover { background-color: $surface-4; }
.az-pagelink.on { background-color: $accent; color: $sur-accent; font-weight: 700; }
