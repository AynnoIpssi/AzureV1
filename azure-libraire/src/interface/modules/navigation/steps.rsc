.az-steps { display: flex; flex-direction: row; gap: 18px; align-items: center; }
.az-step { display: flex; flex-direction: row; align-items: center; gap: 8px; }
.az-step-dot { width: 26px; height: 26px; border-radius: $rayon-rond; background-color: $surface-4; color: $texte-discret; font-size: 12px; font-weight: 700; text-align: center; line-height: 26px; }
.az-step-dot.done { background-color: $succes/18; color: $succes-texte; }
.az-step-dot.current { background-color: $accent; color: $sur-accent; }
.az-step-label { color: $texte-doux; font-size: 13px; }
