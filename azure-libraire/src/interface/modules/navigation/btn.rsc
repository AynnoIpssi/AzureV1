.az-btn { padding: 8px 16px; border-radius: $rayon; background-color: $surface-4; border: 1px solid $trait/8; color: $texte; font-size: 14px; font-weight: 500; }
.az-btn:hover { background-color: $surface-5; }
.az-btn.primary { background-color: $accent; border-color: $accent; color: $sur-accent; }
.az-btn.primary:hover { background-color: $accent-vif; }
.az-btn.danger { background-color: $danger/14; border-color: $danger/35; color: $danger-texte; }
.az-btn.ghost { background-color: transparent; border-color: transparent; color: $accent-texte; }
.az-btn.small { padding: 4px 10px; font-size: 12px; }
