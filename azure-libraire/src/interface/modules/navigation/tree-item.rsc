.az-tree-item { padding: 5px 8px; border-radius: $rayon-petit; background-color: transparent; color: $texte-attenue; font-size: 13px; text-align: left; flex-shrink: 0; }
.az-tree-item:hover { background-color: $trait/5; color: $texte-fort; }
.az-tree-item.on { background-color: $accent/12; color: $accent-texte; }
.az-tree-item.az-niveau-1 { margin-left: 14px; }
.az-tree-item.az-niveau-2 { margin-left: 28px; }
.az-tree-item.az-niveau-3 { margin-left: 42px; }
.az-tree-item.az-niveau-4 { margin-left: 56px; }
.az-tree-item.az-niveau-5 { margin-left: 70px; }
.az-tree-item.az-niveau-6 { margin-left: 84px; }
