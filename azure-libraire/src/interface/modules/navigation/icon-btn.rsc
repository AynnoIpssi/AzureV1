.az-icon-btn { width: 32px; height: 32px; padding: 0; border-radius: $rayon; background-color: transparent; color: $texte-attenue; font-size: 14px; font-weight: 600; flex-shrink: 0; }
.az-icon-btn:hover { background-color: $trait/8; color: $texte-fort; }
.az-icon-btn.small { width: 24px; height: 24px; font-size: 12px; border-radius: $rayon-petit; }
.az-icon-btn.primary { background-color: $accent; color: $sur-accent; }
.az-icon-btn.primary:hover { background-color: $accent-vif; color: $sur-accent; }
