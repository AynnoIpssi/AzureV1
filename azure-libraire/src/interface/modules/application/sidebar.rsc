.az-sidebar { display: flex; flex-direction: column; gap: 12px; width: 232px; flex-shrink: 0; padding: 16px 10px; background-color: $fond-barre; border-right: 1px solid $trait/6; }
.az-sidebar.etroit { width: 180px; }
.az-sidebar-title { padding: 0 10px; color: $texte-fort; font-size: 16px; font-weight: 700; }
.az-sidebar-body { display: flex; flex-direction: column; gap: 2px; flex-grow: 1; min-height: 0; overflow-y: auto; }
