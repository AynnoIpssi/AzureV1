.az-sidebar-item { padding: 8px 10px; border-radius: $rayon; background-color: transparent; color: $texte-discret; font-size: 14px; text-align: left; flex-shrink: 0; }
.az-sidebar-item:hover { background-color: $trait/5; color: $texte-fort; }
.az-sidebar-item.on { background-color: $accent/12; color: $accent-texte; font-weight: 600; }
