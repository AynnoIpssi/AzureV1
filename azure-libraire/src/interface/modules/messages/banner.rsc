.az-banner { display: flex; flex-direction: row; align-items: center; gap: 12px; padding: 10px 16px; background: linear-gradient(90deg, $accent-ombre 0%, $accent-nuit 100%); }
.az-banner-text { flex-grow: 1; color: $sur-couleur; font-size: 13px; font-weight: 600; }
.az-banner-close { padding: 2px 9px; border-radius: $rayon-petit; background-color: $trait/18; color: $sur-couleur; font-size: 12px; }
