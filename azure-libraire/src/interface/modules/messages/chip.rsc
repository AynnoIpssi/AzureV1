.az-chip { display: flex; flex-direction: row; align-items: center; gap: 6px; padding: 4px 6px 4px 12px; border-radius: $rayon-rond; background-color: $accent/10; }
.az-chip-text { color: $accent-texte-vif; font-size: 13px; }
.az-chip-x { padding: 2px 8px; border-radius: $rayon-rond; background-color: $trait/8; color: $texte-attenue; font-size: 11px; }
