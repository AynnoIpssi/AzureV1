.az-alert { display: flex; flex-direction: column; gap: 4px; padding: 12px 16px; border-radius: $rayon-moyen; background-color: $accent/10; border: 1px solid $accent/30; }
.az-alert-title { color: $accent-texte-vif; font-size: 14px; font-weight: 700; }
.az-alert-text { color: $texte-doux; font-size: 13px; }
.az-alert.succes { background-color: $succes/8; border-color: $succes/30; }
.az-alert.succes .az-alert-title { color: $succes-texte; }
.az-alert.attention { background-color: $attention/8; border-color: $attention/30; }
.az-alert.attention .az-alert-title { color: $attention-texte; }
.az-alert.danger { background-color: $danger/8; border-color: $danger/30; }
.az-alert.danger .az-alert-title { color: $danger-texte; }
