.az-badge { padding: 2px 10px; border-radius: $rayon-rond; font-size: 12px; font-weight: 600; background-color: $accent/14; color: $accent-texte; }
.az-badge.succes { background-color: $succes/12; color: $succes-texte; }
.az-badge.danger { background-color: $danger/12; color: $danger-texte; }
.az-badge.attention { background-color: $attention/12; color: $attention-texte; }
.az-badge.neutre { background-color: $trait/6; color: $texte-attenue; }
