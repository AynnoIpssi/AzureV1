.az-count { min-width: 20px; padding: 1px 6px; border-radius: $rayon-rond; background-color: $trait/8; color: $texte-attenue; font-size: 11px; font-weight: 700; text-align: center; }
.az-count.accent { background-color: $accent; color: $sur-accent; }
.az-count.danger { background-color: $danger/18; color: $danger-texte; }
