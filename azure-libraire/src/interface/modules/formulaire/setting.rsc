.az-setting { display: flex; flex-direction: row; align-items: center; gap: 16px; padding: 12px 0; border-bottom: 1px solid $trait/5; }
.az-setting-main { display: flex; flex-direction: column; gap: 2px; flex-grow: 1; min-width: 0; }
.az-setting-title { color: $texte-fort; font-size: 14px; font-weight: 500; }
.az-setting-desc { color: $texte-discret; font-size: 12px; }
.az-setting-control { display: flex; flex-direction: row; align-items: center; gap: 8px; flex-shrink: 0; }
