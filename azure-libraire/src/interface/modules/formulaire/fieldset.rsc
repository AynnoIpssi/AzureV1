.az-fieldset { display: flex; flex-direction: column; gap: 4px; padding: 16px 18px; border: 1px solid $trait/8; border-radius: $rayon-grand; }
.az-fieldset-title { color: $texte-fort; font-size: 15px; font-weight: 600; }
.az-fieldset-desc { color: $texte-discret; font-size: 13px; }
.az-fieldset-body { display: flex; flex-direction: column; gap: 14px; margin-top: 10px; }
