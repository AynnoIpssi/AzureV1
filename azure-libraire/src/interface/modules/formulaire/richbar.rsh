<container.az-richbar.{{class}}>
    <tooltip texte="Gras (Ctrl+B)"><button.az-rt.az-rt-gras#rt-{{pour}}-gras>G<!button><!tooltip>
    <tooltip texte="Italique (Ctrl+I)"><button.az-rt.az-rt-italique#rt-{{pour}}-italique>I<!button><!tooltip>
    <tooltip texte="Souligné (Ctrl+U)"><button.az-rt.az-rt-souligne#rt-{{pour}}-souligne>S<!button><!tooltip>
    <tooltip texte="Barré (Ctrl+Maj+S)"><button.az-rt.az-rt-barre#rt-{{pour}}-barre>B<!button><!tooltip>
    <tooltip texte="Code (Ctrl+E)"><button.az-rt.az-rt-code#rt-{{pour}}-code>code<!button><!tooltip>
    <container.az-rt-sep><!container>
    <tooltip texte="Couleur par défaut"><button.az-rt-c.az-rt-defaut#rt-{{pour}}-couleur->A<!button><!tooltip>
    <tooltip texte="Rouge"><button.az-rt-c.az-rt-rouge#rt-{{pour}}-couleur-e06c75>A<!button><!tooltip>
    <tooltip texte="Orange"><button.az-rt-c.az-rt-orange#rt-{{pour}}-couleur-d19a66>A<!button><!tooltip>
    <tooltip texte="Jaune"><button.az-rt-c.az-rt-jaune#rt-{{pour}}-couleur-e5c07b>A<!button><!tooltip>
    <tooltip texte="Vert"><button.az-rt-c.az-rt-vert#rt-{{pour}}-couleur-98c379>A<!button><!tooltip>
    <tooltip texte="Violet"><button.az-rt-c.az-rt-violet#rt-{{pour}}-couleur-c678dd>A<!button><!tooltip>
    <tooltip texte="Gris"><button.az-rt-c.az-rt-gris#rt-{{pour}}-couleur-8a8a8a>A<!button><!tooltip>
<!container>
