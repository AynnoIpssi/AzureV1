.az-drawer-backdrop { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 90; display: flex; flex-direction: row; justify-content: flex-end; background-color: $voile/50; }
.az-drawer { display: flex; flex-direction: column; gap: 14px; width: 360px; padding: 18px 20px; background-color: $surface-2; border-left: 1px solid $trait/8; }
.az-drawer-body { display: flex; flex-direction: column; gap: 10px; flex-grow: 1; min-height: 0; overflow-y: auto; }
