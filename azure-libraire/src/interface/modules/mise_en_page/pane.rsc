.az-pane { display: flex; flex-direction: column; gap: 10px; flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; padding: 16px; overflow-y: auto; border-right: 1px solid $trait/6; }
.az-pane.etroit { flex-grow: 0; flex-basis: auto; width: 260px; flex-shrink: 0; }
.az-pane.large { flex-grow: 0; flex-basis: auto; width: 420px; flex-shrink: 0; }
.az-pane.creux { background-color: $fond-creux; }
