.az-header { display: flex; flex-direction: row; align-items: center; gap: 16px; }
.az-header-main { display: flex; flex-direction: column; gap: 4px; flex-grow: 1; min-width: 0; }
.az-header-title { color: $texte-fort; font-size: 22px; font-weight: 700; }
.az-header-desc { color: $texte-discret; font-size: 13px; }
.az-header-actions { display: flex; flex-direction: row; align-items: center; gap: 8px; flex-shrink: 0; }
