/* Champs natifs (dessines par la fondation) : couleurs de piste, de texte et d'accent. */
checkbox { color: $texte; background-color: $surface-3; font-size: 14px; }
radio { color: $texte; background-color: $surface-3; font-size: 14px; }
switch { color: $texte; background-color: $surface-6; font-size: 14px; }
slider { background-color: $surface-6; }
progress { background-color: $surface-5; }
select { color: $texte; background-color: $surface-2; font-size: 14px; }
segmented { color: $texte-attenue; background-color: $surface-3; font-size: 13px; }
rating { accent-color: $attention; background-color: $surface-6; color: $texte-attenue; font-size: 13px; }
input { width: 260px; height: 36px; background-color: $surface; color: $texte; border: 1px solid $trait/12; border-radius: $rayon; }
input:hover { background-color: $surface-2; }
input:focus { background-color: $surface-3; }
.az-error { color: $danger-texte; background-color: $danger/12; padding: 4px 8px; border-radius: $rayon-petit; font-size: 13px; }
richtext { min-height: 120px; padding: 6px; border-radius: $rayon; background-color: $trait/3; color: $texte; }
graphe { color: $texte-discret; background-color: $trait/8; }
