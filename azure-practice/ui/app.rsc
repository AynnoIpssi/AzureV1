.app{
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100vh;
}

.card-container {
    display: grid; 
    grid-template-columns: repeat(3, 1fr);
    height: 280px
    width: 20vw;
    gap: 20px;
}

.card{
    width: 150px;
    height: 80px;
    border: 1px, solid;
    border-radius: 15px;
    border-color: #c19457;
}




