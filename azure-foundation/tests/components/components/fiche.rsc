.fiche { display: flex; flex-direction: row; gap: 12px; align-items: center; padding: 16px; background-color: #161b2b; border-radius: 12px; }
.fiche-texte { display: flex; flex-direction: column; gap: 2px; }
.fiche-nom { color: #f5f6fa; font-size: 15px; font-weight: 600; }
.fiche-role { color: #8b90a7; font-size: 13px; }
