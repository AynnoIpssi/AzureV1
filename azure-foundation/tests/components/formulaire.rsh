<container.f>
<input#nom placeholder="Votre nom"/>
<number#age/>
<password#mdp/>
<checkbox#cgu>J'accepte<!checkbox>
<radio#r-s name="taille" value="S">S<!radio>
<radio#r-m name="taille" value="M" checked="true">M<!radio>
<radio#r-l name="taille" value="L">L<!radio>
<switch#sombre label="Sombre"/>
<slider#volume value="10" step="5" style="x"/>
<select#pays options="France, Belgique, Suisse"/>
<segmented#vue options="Jour, Semaine, Mois"/>
<rating#note value="1"/>
<btn#ok>OK<!btn>
<checkbox#off disabled="true">Desactivee<!checkbox>
<!container>
