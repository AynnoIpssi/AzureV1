<container.ecran>
    <container.chrome>
        <container.pastille><!container><container.pastille><!container><container.pastille><!container>
        <text.url>scratch-lite/index.html<!text>
    <!container>
    <container.app>
        <container.barre>
            <text.logo>Scratch Lite<!text>
            <text.menu>Fichier<!text><text.menu>Exemples<!text>
            <text.projet>Mon projet : le chat qui danse<!text>
        <!container>
        <container.corps>
            <container.categories>
                <container.cat><container.rond.mouv><!container><text.cat-nom>Mouvement<!text><!container>
                <container.cat><container.rond.appa><!container><text.cat-nom>Apparence<!text><!container>
                <container.cat><container.rond.even><!container><text.cat-nom>Événements<!text><!container>
                <container.cat.actif><container.rond.ctrl><!container><text.cat-nom>Contrôle<!text><!container>
                <container.cat><container.rond.capt><!container><text.cat-nom>Capteurs<!text><!container>
                <container.cat><container.rond.oper><!container><text.cat-nom>Opérateurs<!text><!container>
                <container.cat><container.rond.vari><!container><text.cat-nom>Variables<!text><!container>
            <!container>
            <container.palette>
                <text.pal-titre>Contrôle<!text>
                <text.bloc.ctrl>attendre 1 seconde<!text>
                <text.bloc.ctrl>répéter 10 fois<!text>
                <text.bloc.ctrl>répéter indéfiniment<!text>
                <text.bloc.ctrl>si … alors<!text>
                <text.bloc.ctrl>si … alors … sinon<!text>
                <text.bloc.ctrl>attendre jusqu'à …<!text>
                <text.bloc.ctrl>stop tout<!text>
            <!container>
            <container.scripts>
                <container.script>
                    <text.bloc.even.chapeau>quand le drapeau est cliqué<!text>
                    <text.bloc.mouv>aller à x: 0 y: 0<!text>
                    <text.bloc.vari>mettre score à 0<!text>
                    <container.boucle>
                        <text.bloc.ctrl.haut>répéter 10 fois<!text>
                        <container.dedans>
                            <text.bloc.mouv>avancer de 10 pas<!text>
                            <text.bloc.mouv>tourner de 15 degrés<!text>
                            <text.bloc.appa>costume suivant<!text>
                            <text.bloc.vari>ajouter 1 à score<!text>
                            <text.bloc.ctrl>attendre 0.2 seconde<!text>
                        <!container>
                        <text.bloc.ctrl.pied> <!text>
                    <!container>
                    <text.bloc.appa>dire « Fini ! » pendant 2 secondes<!text>
                <!container>
                <container.script>
                    <text.bloc.even.chapeau>quand la touche espace est pressée<!text>
                    <container.boucle>
                        <text.bloc.ctrl.haut>si touchant le bord ? alors<!text>
                        <container.dedans><text.bloc.mouv>rebondir si le bord est atteint<!text><!container>
                        <text.bloc.ctrl.pied> <!text>
                    <!container>
                <!container>
            <!container>
            <container.droite>
                <container.commandes><text.drapeau>Lancer<!text><text.stop>Stop<!text><text.score>score : 7<!text><!container>
                <container.scene>
                    <container.bulle><text.bulle-texte>Fini !<!text><!container>
                    <container.lutin>
                        <container.tete><container.oeil><!container><container.oeil><!container><!container>
                        <container.corps-lutin><!container>
                    <!container>
                <!container>
                <container.infos>
                    <text.info>Lutin : Chat<!text><text.info>x : 42<!text><text.info>y : -18<!text><text.info>direction : 105°<!text>
                <!container>
            <!container>
        <!container>
    <!container>
<!container>
