.terminal { display: flex; flex-direction: column; height: 100%; background-color: #0c0c0c; }
.barre { display: flex; flex-direction: row; align-items: center; gap: 8px; height: 40px; padding: 0 14px; flex-shrink: 0; background-color: #1f1f1f; }
.pastille { width: 12px; height: 12px; border-radius: 999px; background-color: #3c3c3c; }
.titre-fenetre { flex-grow: 1; text-align: center; color: #a0a0a0; font-size: 13px; }
.sortie { display: flex; flex-direction: column; align-self: center; gap: 1px; padding: 26px 40px; }
.l { color: #cccccc; font-family: monospace; font-size: 19px; white-space: pre; }
.l.gris { color: #7a7a7a; }
.l.erreur { margin-top: 6px; color: #e06c75; }
.cmd { margin-top: 6px; color: #9fdc9f; font-family: monospace; font-size: 19px; white-space: pre; }
