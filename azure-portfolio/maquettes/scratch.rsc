.app { display: flex; flex-direction: column; flex-grow: 1; background-color: #eef1f6; color: #2a2f3a; }
.barre { display: flex; flex-direction: row; align-items: center; gap: 22px; height: 48px; padding: 0 18px; flex-shrink: 0; background-color: #6a4fd1; }
.logo { color: #ffffff; font-size: 17px; font-weight: 800; }
.menu { color: #e4dcff; font-size: 14px; }
.projet { margin-left: auto; padding: 6px 12px; background-color: rgba(255, 255, 255, 0.18); border-radius: 6px; color: #ffffff; font-size: 13px; }
.corps { display: flex; flex-direction: row; flex-grow: 1; }
.categories { display: flex; flex-direction: column; gap: 4px; width: 92px; flex-shrink: 0; padding: 10px 0; background-color: #ffffff; border-right: 1px solid #dde2ea; }
.cat { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 8px 0; }
.cat.actif { background-color: #f1ecff; }
.rond { width: 22px; height: 22px; border-radius: 999px; }
.cat-nom { color: #5b6272; font-size: 11px; }
.palette { display: flex; flex-direction: column; gap: 8px; width: 220px; flex-shrink: 0; padding: 14px; background-color: #f8f9fb; border-right: 1px solid #dde2ea; }
.pal-titre { margin-bottom: 4px; color: #5b6272; font-size: 13px; font-weight: 700; }
.scripts { display: flex; flex-direction: column; gap: 26px; flex-grow: 1; padding: 22px; }
.script { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; }
.bloc { padding: 9px 14px; border-radius: 6px; color: #ffffff; font-size: 13px; font-weight: 600; }
.bloc.chapeau { padding: 14px 18px 9px 18px; border-radius: 16px; }
.mouv, .bloc.mouv { background-color: #4c7fe0; }
.appa, .bloc.appa { background-color: #9366e0; }
.even, .bloc.even { background-color: #e6a822; }
.ctrl, .bloc.ctrl { background-color: #e08a2c; }
.capt, .bloc.capt { background-color: #3aa7d6; }
.oper, .bloc.oper { background-color: #4cb05a; }
.vari, .bloc.vari { background-color: #e5663a; }
.boucle { display: flex; flex-direction: column; align-items: flex-start; }
.bloc.haut { border-radius: 6px 6px 0 0; }
.dedans { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; padding: 2px 0 2px 18px; border-left: 16px solid #e08a2c; }
.bloc.pied { width: 90px; height: 6px; padding: 5px 0; }
.droite { display: flex; flex-direction: column; gap: 10px; width: 400px; flex-shrink: 0; padding: 14px; }
.commandes { display: flex; flex-direction: row; align-items: center; gap: 10px; }
.drapeau { padding: 6px 12px; background-color: #4cb05a; border-radius: 6px; color: #ffffff; font-size: 13px; font-weight: 700; }
.stop { padding: 6px 12px; background-color: #d9534f; border-radius: 6px; color: #ffffff; font-size: 13px; font-weight: 700; }
.score { margin-left: auto; padding: 4px 10px; background-color: #e5663a; border-radius: 999px; color: #ffffff; font-size: 12px; font-weight: 700; }
.scene { position: relative; height: 290px; background-color: #ffffff; border: 1px solid #d3d9e3; border-radius: 8px; }
.lutin { position: absolute; top: 90px; left: 170px; display: flex; flex-direction: column; align-items: center; width: 90px; }
.bulle { position: absolute; top: 48px; left: 236px; padding: 8px 12px; background-color: #ffffff; border: 2px solid #c9ced8; border-radius: 12px; }
.bulle-texte { font-size: 13px; font-weight: 700; }
.tete { display: flex; flex-direction: row; justify-content: center; gap: 12px; width: 64px; height: 52px; padding-top: 18px; background-color: #f2a33a; border-radius: 26px; }
.oeil { width: 9px; height: 12px; border-radius: 999px; background-color: #2a2f3a; }
.corps-lutin { width: 50px; height: 58px; margin-top: -6px; background-color: #f2a33a; border-radius: 22px; }
.infos { display: flex; flex-direction: row; flex-wrap: wrap; gap: 8px; padding: 10px; background-color: #ffffff; border: 1px solid #d3d9e3; border-radius: 8px; }
.info { padding: 4px 8px; background-color: #eef1f6; border-radius: 4px; color: #5b6272; font-size: 12px; }
