.app { display: flex; flex-direction: row; flex-grow: 1; background-color: #f6f6f8; color: #1f2230; }
.gauche { display: flex; flex-direction: column; flex-grow: 1; min-width: 0; border-right: 1px solid #dcdde3; }
.outils { display: flex; flex-direction: row; align-items: center; gap: 14px; padding: 12px 16px; background-color: #ffffff; border-bottom: 1px solid #e3e4ea; }
.bouton { padding: 7px 12px; background-color: #5b3fc4; border-radius: 6px; color: #ffffff; font-size: 13px; font-weight: 700; }
.resume { color: #5d6070; font-size: 13px; }
.ok-compte { color: #23803d; font-size: 13px; font-weight: 700; }
.ko-compte { color: #c7362f; font-size: 13px; font-weight: 700; }
.duree { margin-left: auto; color: #8a8d9a; font-size: 13px; }
.arbre { display: flex; flex-direction: column; padding: 8px 0; flex-grow: 1; background-color: #ffffff; }
.groupe { display: flex; flex-direction: row; align-items: center; gap: 10px; padding: 9px 16px; margin-top: 4px; }
.g-nom { font-size: 13px; font-weight: 700; }
.g-n { color: #8a8d9a; font-size: 12px; }
.test { display: flex; flex-direction: row; align-items: center; gap: 10px; padding: 6px 16px 6px 40px; }
.test.choisi { background-color: #fdeceb; }
.pt { width: 10px; height: 10px; flex-shrink: 0; border-radius: 999px; }
.pt.ok { background-color: #2f9e4f; }
.pt.ko { background-color: #d8443c; }
.t-nom { flex-grow: 1; font-family: monospace; font-size: 12px; }
.t-d { color: #8a8d9a; font-size: 12px; }
.detail { display: flex; flex-direction: column; gap: 4px; padding: 12px 16px; background-color: #fff7f6; border-top: 1px solid #f0d3d0; }
.d-titre { color: #c7362f; font-size: 13px; font-weight: 700; }
.d-ligne { font-family: monospace; font-size: 12px; white-space: pre; }
.d-ligne.gris { color: #8a8d9a; }
.droite { display: flex; flex-direction: column; align-items: center; gap: 12px; width: 360px; flex-shrink: 0; padding: 16px; background-color: #ececf1; }
.d-label { align-self: flex-start; color: #6a6d7a; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
.telephone { display: flex; width: 230px; height: 400px; padding: 10px; background-color: #1f2230; border-radius: 28px; }
.ecran-tel { display: flex; flex-direction: column; gap: 8px; flex-grow: 1; padding: 34px 18px; background-color: #ffffff; border-radius: 20px; }
.tel-titre { margin-bottom: 14px; font-size: 20px; font-weight: 800; }
.tel-label { color: #6a6d7a; font-size: 11px; font-weight: 600; }
.tel-champ { padding: 9px 10px; border: 1px solid #d5d6de; border-radius: 8px; font-size: 13px; }
.tel-bouton { margin-top: 12px; padding: 10px; background-color: #5b3fc4; border: 3px solid #f2b705; border-radius: 8px; color: #ffffff; font-size: 13px; font-weight: 700; text-align: center; }
.journal { display: flex; flex-direction: column; gap: 3px; align-self: stretch; padding: 10px 12px; background-color: #1f2230; border-radius: 8px; }
.j { color: #b9bccb; font-family: monospace; font-size: 11px; }
.j.actif { color: #f2b705; }
