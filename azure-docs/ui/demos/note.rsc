.note { display: flex; flex-direction: column; gap: 8px; height: 100%; padding: 24px 28px; background-color: #1a1917; border-top: 4px solid #c9a878; }
.note-sur { color: #c9a878; font-size: 12px; font-weight: 700; letter-spacing: 1px; }
.note-titre { color: #f0eeea; font-size: 24px; font-weight: 700; margin-bottom: 4px; }
.note-ligne { color: #d6d3cc; font-size: 15px; }
.note-pied { margin-top: auto; color: #6f6c66; font-size: 12px; line-height: 1.5; }
