<container.fen>
    <text.fen-surtitre>DÉMONSTRATION · TAILLES<!text>
    <title1.fen-titre>{{nom}}<!title1>
    <container.centre>
        <text.taille>{{largeur}} × {{hauteur}}<!text>
        <text.fen-texte>WindowSize::new({{largeur}}, {{hauteur}})<!text>
    <!container>
    <text.fen-pied>Chaque fenêtre est indépendante : ferme-les dans l'ordre que tu veux.<!text>
<!container>
