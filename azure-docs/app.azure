# La documentation d'Azure est elle-meme une app Azure.
[app]
name = docs
title = Azure Docs
exec = azure_docs
icon = icone.png
files = ui, contenu

# Pour Azure Note : chercher dans la doc et en afficher une page. Servies par
# la tache de fond `methodes` (Docs sans fenetre), qu'Azure lance au premier
# appel : pas besoin d'ouvrir Docs.
[service methodes]
command = azure_docs
args = --service
restart = on-failure

[provide chercher]
to = note
service = methodes
description = Chercher dans la documentation (q -> resultats)

[provide page]
to = note
service = methodes
description = Une page de la documentation (chemin ou exemple -> blocs)

[window]
title = Azure Docs
width = 1280
height = 860
start = /
style = ui/docs.rsc
