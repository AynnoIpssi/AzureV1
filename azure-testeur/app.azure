# Azure Testeur : trouve les tests d'un projet (ou d'Azure lui-meme), les
# lance, et en ecrit de nouveaux dans son atelier.
[app]
name = testeur
title = Azure Testeur
version = 0.1
exec = azure_testeur
icon = icone.png
files = ui

[window]
title = Azure Testeur
width = 1280
height = 820
start = /
style = ui/testeur.rsc

# Lire et compiler les projets (cargo ecrit target/ et ~/.cargo, telecharge
# les dependances). Un projet hors de ces dossiers : l'ajouter ici.
[permissions]
lecture = ~/.rustup
ecriture = ~/Dev, ~/.cargo
reseau = true
